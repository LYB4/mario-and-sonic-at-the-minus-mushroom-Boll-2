		pathcanfall : pathcanfall,
		pathdraw : pathdraw,
		pathstarted : pathstarted,
		rotdat : rotdat,
		rotangle : rotangle,
		rotdist : rotdist,
		rotorgx : rotorgx,
		rotorgy : rotorgy,
		rotspd : rotspd,
		rotating : rotating
	}
}